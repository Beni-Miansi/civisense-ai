# Copier ce fichier en .env.local puis remplir avec les vraies valeurs.
# .env.local n'est jamais commité (voir .gitignore).

# Supabase → Project Settings → Data API → « Project URL »
NEXT_PUBLIC_SUPABASE_URL=https://gkilzzqfvdurczqzmjsk.supabase.co

# Supabase → Project Settings → API Keys → « Publishable key » (sb_publishable_...)
# Si l'onglet « Legacy API keys » est affiché à la place : clé « anon public ».
# Clé publique : exposée au navigateur, protégée par les règles RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Project Settings → API Keys → « Secret key » (sb_secret_...)
# Si clés legacy : clé « service_role ».
# SECRÈTE : contourne la RLS. Uniquement côté serveur (scripts de seed, actions admin).
# Ne jamais la préfixer par NEXT_PUBLIC_ ni la partager.
SUPABASE_SECRET_KEY=

# Mot de passe commun des comptes de démo créés par `npm run seed` (voir DEMO.md, non commité).
SEED_DEMO_PASSWORD=

# Classification de catégorie par IA (facultatif : sans clé, repli automatique par mots-clés).
# console.anthropic.com → Settings → API Keys. SECRÈTE : uniquement côté serveur, jamais NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Modèle utilisé (facultatif). Par défaut : claude-opus-5-5. Plus rapide et moins cher : claude-haiku-5-5.
CLASSIFICATION_MODEL=

# Alternative gratuite pour la démo (utilisée si ANTHROPIC_API_KEY est vide) : console.groq.com → API Keys.
# SECRÈTE : uniquement côté serveur, jamais NEXT_PUBLIC_.
GROQ_API_KEY=
# Modèle Groq (facultatif). Par défaut : openai/gpt-oss-120b.
GROQ_MODEL=
